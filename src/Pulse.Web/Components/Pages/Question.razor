@page "/questions/{Id:guid}"
@rendermode InteractiveServer
@inject QuestionService Questions
@inject NavigationManager Navigation
@inject ILogger<Question> Logger
@using Pulse.Web.Services
@using Pulse.Web.Components.Shared

<PageTitle>PULSE question</PageTitle>

<a href="/">← PULSE</a>

@if (_loading)
{
    <p>Loading…</p>
}
else if (_error is not null)
{
    <p role="alert">@_error</p>
}
else if (_question is null)
{
    <h1>Question not found</h1>
}
else
{
    <h1>@_question.Text</h1>

    <p>Created @_question.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</p>

    <label for="share-link">Share this question</label>
    <input id="share-link"
           readonly
           value="@Navigation.ToAbsoluteUri($"questions/{Id}")" />

    <VoteForm QuestionId="@Id"
              @key="Id"
              OnSaved="RefreshResults" />

    <ResultPanel QuestionId="@Id"
                 Revision="@_resultRevision" />

    <ResultHistory QuestionId="@Id"
              @key="(Id, nameof(ResultHistory))" />
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private QuestionDetails? _question;
    private string? _error;
    private bool _loading = true;
    private int _resultRevision;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _question = null;
        _error = null;

        try
        {
            _question = await Questions.GetAsync(Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load question {QuestionId}", Id);
            _error = "Could not load the question. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void RefreshResults()
    {
        _resultRevision++;
    }
}