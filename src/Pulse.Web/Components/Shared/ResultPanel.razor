@using System.Globalization
@using Pulse.Web.Domain
@using Pulse.Web.Services
@inject ResultService Results
@inject ILogger<ResultPanel> Logger

<section class="card results-card" aria-labelledby="results-title">
    <div class="card-heading"><p class="eyebrow">The group’s perspective</p><span class="subtle-tag">Latest answers</span></div>
    <h2 id="results-title">Where the group stands</h2>
    <p class="muted">A snapshot of everyone’s latest view.</p>
    @if (_error is not null)
    {
        <p class="notice notice-error" role="alert">@_error</p>
    }
    else if (_result is null)
    {
        <div class="empty-state compact" role="status"><span class="loading-dot"></span><p>Loading results…</p></div>
    }
    else if (_result.ParticipantCount == 0)
    {
        <div class="empty-state compact"><div class="empty-mark" aria-hidden="true">—</div><h3>No votes yet</h3><p class="muted">Be the first to share a perspective.<br />The group’s results will appear here.</p></div>
    }
    else
    {
        <p class="result-description">@DescribeResult(_result)</p>
        <figure class="result-chart">
            <figcaption class="field-help">Latest answer distribution</figcaption>
            <div class="result-distribution" role="img" aria-label="@ChartLabel(_result)">
                @foreach (var row in _result.Answers.Where(a => a.Count > 0))
                {
                    <span class="distribution-segment @row.Answer.ToString().ToLowerInvariant()"
                        style="@($"flex-grow: {row.Count.ToString(CultureInfo.InvariantCulture)}")"></span>
                }
            </div>
        </figure>
        <div class="answer-summaries">
            @foreach (var row in _result.Answers)
            {
                <div class="answer-summary @row.Answer.ToString().ToLowerInvariant()">
                    <span class="answer-name"><span class="answer-dot @row.Answer.ToString().ToLowerInvariant()" aria-hidden="true"></span>@row.Answer</span>
                    <strong class="answer-percentage">@Format(row.Percentage)<span>%</span></strong>
                    <span class="answer-count">@row.Count @(row.Count == 1 ? "person" : "people")</span>
                    <div class="answer-confidence"><span>Avg. confidence</span><strong>@Format(row.AverageConfidence)</strong></div>
                </div>
            }
        </div>
        <dl class="result-stats">
            <div><dt>Participants</dt><dd>@_result.ParticipantCount</dd></div>
            <div><dt>Changed their answer</dt><dd>@_result.ChangedAnswerCount <span>(@Format(_result.ChangedAnswerPercentage)%)</span></dd></div>
        </dl>
        <p class="result-note">Each participant counts once. Confidence is self-reported and does not change vote weight.</p>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public Guid QuestionId { get; set; }

    [Parameter]
    public int Revision { get; set; }

    private ResultSnapshot? _result;
    private string? _error;
    private int _loadVersion;
    private Guid _loadedQuestion;
    private int _loadedRevision = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedQuestion == QuestionId && _loadedRevision == Revision && _error is null) return;
        _loadedQuestion = QuestionId;
        _loadedRevision = Revision;
        var version = ++_loadVersion;
        _result = null;
        _error = null;

        try
        {
            var result = await Results.GetCurrentAsync(QuestionId);

            if (version == _loadVersion)
                _result = result;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load results.");

            if (version == _loadVersion)
                _error = "Could not load results. Please reload the page.";
        }
    }

    private static string Format(decimal? value) =>
        value?.ToString("0.0", CultureInfo.InvariantCulture) ?? "—";

    private static string ChartLabel(ResultSnapshot result) => string.Join("; ",
        result.Answers.Select(a => $"{a.Answer}: {a.Count} votes, {Format(a.Percentage)} percent"));

    private static string DescribeResult(ResultSnapshot result)
    {
        var largest = result.Answers.Max(a => a.Count);
        var leaders = result.Answers.Where(a => a.Count == largest).ToArray();
        return leaders.Length == 1
            ? $"{leaders[0].Answer} currently leads with {Format(leaders[0].Percentage)}% of participants."
            : $"{string.Join(" and ", leaders.Select(a => a.Answer))} are tied at {Format(leaders[0].Percentage)}% each.";
    }
}
