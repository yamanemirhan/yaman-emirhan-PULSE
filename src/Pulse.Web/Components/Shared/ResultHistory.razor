@using System.Text.Json
@using Pulse.Web.Domain
@using Pulse.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ResultService Results
@inject ILogger<ResultHistory> Logger

<AuthorizeView Roles="Administrator">
<Authorized>
<details class="history-panel">
    <summary class="history-heading"><span><span class="eyebrow">Behind the result</span><span class="history-title">Stored results &amp; replay</span></span><span class="details-chevron" aria-hidden="true">+</span></summary>
    <div class="history-body">

    <p class="muted">
        Compare saved outputs with a fresh calculation
        using their original event boundaries and versions.
    </p>

    <button class="button button-outline" type="button" @onclick="CompareAsync" disabled="@_busy">
        @(_busy ? "Comparing…" : "Compare stored results")
    </button>

    @if (_error is not null)
    {
        <p class="notice notice-error" role="alert">@_error</p>
    }

    @if (_comparisons is not null)
    {
        @if (_comparisons.Count == 0)
        {
            <p class="empty-state compact">No stored results yet.</p>
        }

        @foreach (var item in _comparisons)
        {
            <details class="history-item" @key="item.Id">
                <summary>
                    <span>Through event <strong>@item.Stored.ThroughSequence</strong> <span class="muted">· @item.Stored.AlgorithmVersion</span></span>
                    <span class="status-badge @(item.Matches ? "status-match" : "status-mismatch")">@(item.Matches ? "Match" : "MISMATCH")</span>
                </summary>

                <p class="history-timestamp">
                    First prepared:
                    @item.ServedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC
                </p>

                <div class="replay-grid">
                    <div><h3>Stored output</h3><pre>@ToJson(item.Stored)</pre></div>
                    <div><h3>Replayed output</h3><pre>@ToJson(item.Replayed)</pre></div>
                </div>
            </details>
        }

        <p class="field-help">Run the comparison again after new votes.</p>
    }
    </div>
</details>
</Authorized>
</AuthorizeView>

@code {
    [Parameter, EditorRequired]
    public Guid QuestionId { get; set; }

    private IReadOnlyList<ResultComparison>? _comparisons;
    private bool _busy;
    private string? _error;

    private static readonly JsonSerializerOptions JsonOptions =
        new() { WriteIndented = true };

    private async Task CompareAsync()
    {
        if (_busy)
            return;

        _busy = true;
        _error = null;
        _comparisons = null;

        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _comparisons = await Results.CompareStoredAsync(state.User, QuestionId);
        }
        catch (UnauthorizedAccessException)
        {
            _error = "Administrator access is required.";
        }
        catch (NotSupportedException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Stored result comparison failed.");
            _error = "Could not compare results. No records were changed.";
        }
        finally
        {
            _busy = false;
        }
    }

    private static string ToJson(ResultSnapshot result) =>
        JsonSerializer.Serialize(result, JsonOptions);
}
